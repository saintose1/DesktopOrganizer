<Window x:Class="DesktopOrganizer.App.Views.ProgramSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DesktopOrganizer.App.Views"
        Title="{l:Tr 'Поиск программ'}" Width="390" Height="360" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" Background="{DynamicResource Base}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen" FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
    <Border Style="{StaticResource Card}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr 'Поиск программ'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
            <TextBox x:Name="SearchBox" Grid.Row="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{l:Tr 'Поиск программ'}" AutomationProperties.AutomationId="ProgramSearchQuery" />
            <ListBox x:Name="ResultsList" Grid.Row="2" Margin="0,8,0,6" ItemsSource="{Binding Results}"
                     SelectedItem="{Binding Selected}" DisplayMemberPath="Name" MouseDoubleClick="OnResultDoubleClick" />
            <DockPanel Grid.Row="3">
                <Button DockPanel.Dock="Right" Content="{l:Tr 'Открыть'}" Command="{Binding OpenCommand}" Style="{StaticResource Primary}"/>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource Muted}"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
