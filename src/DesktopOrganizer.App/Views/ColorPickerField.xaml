<UserControl xmlns:l="clr-namespace:DesktopOrganizer.App.Views" x:Class="DesktopOrganizer.App.Views.ColorPickerField" x:Name="Field" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopOrganizer.App.Views">
    <UserControl.Resources>
        <local:ColorCursorOffsetConverter x:Key="CursorOffset"/>
        <Style TargetType="Slider">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Height="24"><Border Height="10" CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1667"/><GradientStop Color="Lime" Offset="0.3333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6667"/><GradientStop Color="Magenta" Offset="0.8333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#55201A2A" BorderBrush="White" BorderThickness="2" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,4,0,12">
        <Button x:Name="SwatchButton" Click="OnOpen" ToolTip="{l:Tr 'Выбрать цвет'}" AutomationProperties.Name="{l:Tr 'Открыть палитру'}">
            <DockPanel><Border DockPanel.Dock="Left" Background="{Binding Color, ElementName=Field}" Width="26" Height="22" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0"/><TextBlock Text="{Binding Color, ElementName=Field}" VerticalAlignment="Center" FontFamily="Consolas"/><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="12,0,0,0"/></DockPanel>
        </Button>
        <Popup x:Name="Palette" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border Background="#141019" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="5" Padding="16" Width="284" DataContext="{Binding Picker, ElementName=Field}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'ПАЛИТРА'}" Style="{StaticResource Caption}"/>
                    <Grid x:Name="Spectrum" Height="156" Margin="0,6,0,10" Cursor="Cross" MouseLeftButtonDown="OnSpectrumDown" MouseMove="OnSpectrumMove" MouseLeftButtonUp="OnSpectrumUp">
                        <Rectangle Fill="{Binding HueColor}"/>
                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                        <Canvas IsHitTestVisible="False"><Ellipse Width="10" Height="10" Stroke="White" StrokeThickness="2" Fill="#20000000"><Canvas.Left><MultiBinding Converter="{StaticResource CursorOffset}"><Binding Path="Saturation"/><Binding ElementName="Spectrum" Path="ActualWidth"/></MultiBinding></Canvas.Left><Canvas.Top><MultiBinding Converter="{StaticResource CursorOffset}" ConverterParameter="Invert"><Binding Path="Value"/><Binding ElementName="Spectrum" Path="ActualHeight"/></MultiBinding></Canvas.Top></Ellipse></Canvas>
                    </Grid>
                    <Slider Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" Value="{Binding Hue, Mode=TwoWay}" AutomationProperties.Name="{l:Tr 'Оттенок'}"/>
                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,12,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="OnPreset" Background="{Binding}" Height="24" Margin="2" Padding="0" ToolTip="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="3"/></ControlTemplate></Button.Template></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <DockPanel><Border Width="35" Background="{Binding Color}" BorderBrush="{StaticResource Line}" BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,10,0"/><TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="{l:Tr 'Точный цвет HEX'}"/></DockPanel>
                    <TextBlock Text="{Binding Error}" Foreground="#FFA9B9" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
