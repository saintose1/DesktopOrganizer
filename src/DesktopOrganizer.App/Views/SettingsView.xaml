<UserControl x:Class="DesktopOrganizer.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="02 / ПРЕДПОЧТЕНИЯ" Style="{StaticResource Caption}" />
            <TextBlock Text="Настройки" FontSize="29" FontWeight="SemiBold" />
            <TextBlock Text="Ваш рабочий стол. Ваш привычный ритм." Foreground="{StaticResource Muted}" Margin="0,8,0,30" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ГРУППЫ НА РАБОЧЕМ СТОЛЕ" Style="{StaticResource Caption}"/>
                        <TextBlock Text="Раскрывать свёрнутый Fence при наведении" FontSize="18" TextWrapping="Wrap" Margin="0,12,20,0"/>
                        <TextBlock Text="Раскрытие и сворачивание без дополнительной задержки. После ухода курсора группа вернётся в своё свёрнутое состояние." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,20,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource StartupToggle}" IsChecked="{Binding AutoExpandOnHover, Mode=TwoWay}" AutomationProperties.AutomationId="HoverExpandToggle" AutomationProperties.Name="Раскрывать свёрнутый Fence при наведении" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="АНИМАЦИЯ ГРУПП" Style="{StaticResource Caption}"/>
                    <TextBlock Text="Плавное раскрытие и сворачивание" FontSize="18" Margin="0,12,0,8" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Раскрытие · секунды" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding ExpandAnimationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}, ValidatesOnExceptions=True}" Margin="0,8,0,0" AutomationProperties.AutomationId="ExpandAnimationSeconds"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Сворачивание · секунды" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding CollapseAnimationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}, ValidatesOnExceptions=True}" Margin="0,8,0,0" AutomationProperties.AutomationId="CollapseAnimationSeconds"/></StackPanel>
                    </Grid>
                    <TextBlock Text="От 0 до 3 секунд. 0 — мгновенно. Изменение сохраняется после выхода из поля и применяется к кнопке в заголовке и hover-раскрытию." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Error}" Foreground="#FFA9B9" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ЗАПУСК И ФОНОВАЯ РАБОТА" Style="{StaticResource Caption}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Запуск вместе с Windows" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Автоматически запускать DesktopOrganizer в трее при входе в Windows. Только для вашего пользователя, без прав администратора." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,20,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource StartupToggle}" IsChecked="{Binding IsStartupEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StartupToggle" AutomationProperties.Name="Запускать DesktopOrganizer вместе с Windows" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="{Binding Error}" Foreground="#FFA9B9" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ПОВЕДЕНИЕ ОКНА" Style="{StaticResource Caption}" />
                    <TextBlock Text="Порядок остаётся, даже когда окно закрыто." FontSize="18" TextWrapping="Wrap" Margin="0,12,0,10" />
                    <TextBlock Text="Крестик скрывает окно в системный трей. Группы продолжают работать на рабочем столе. Один клик по значку возвращает это окно." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    <TextBlock Text="Чтобы полностью завершить приложение, выберите «Выход» в меню значка в трее." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/DesktopOrganizer.App;component/Assets/Branding/dog-original.png" Width="80" Height="80" Margin="0,0,20,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DesktopOrganizer." FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Немного порядка.&#xA;Больше пространства." Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
