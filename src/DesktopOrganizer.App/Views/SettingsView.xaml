<UserControl xmlns:l="clr-namespace:DesktopOrganizer.App.Views" x:Class="DesktopOrganizer.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="MaxWidth" Value="860" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Tr 'Настройки'}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Общие'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                        <TextBlock Text="{l:Tr 'Язык интерфейса'}" FontSize="15" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Русский" GroupName="InterfaceLanguage" IsChecked="{Binding IsRussian, Mode=TwoWay}" Margin="0,0,28,0" AutomationProperties.AutomationId="LanguageRussian" />
                            <RadioButton Content="English" GroupName="InterfaceLanguage" IsChecked="{Binding IsEnglish, Mode=TwoWay}" AutomationProperties.AutomationId="LanguageEnglish" />
                        </StackPanel>
                        <TextBlock Text="{l:Tr 'Применяется сразу: окно, меню в трее и сообщения.'}" Style="{StaticResource Hint}" Margin="0,10,0,18" />
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr 'Запуск вместе с Windows'}" FontSize="15" />
                                <TextBlock Text="{l:Tr 'Автоматически запускать DesktopOrganizer в трее при входе в Windows. Только для вашего пользователя, без прав администратора.'}" Style="{StaticResource Hint}" Margin="0,6,24,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsStartupEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StartupToggle" AutomationProperties.Name="{l:Tr 'Запускать DesktopOrganizer вместе с Windows'}" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Обратная связь'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="{l:Tr 'Сообщения об ошибках публикуются на GitHub.'}" Style="{StaticResource Hint}" />
                        <Button Content="{l:Tr 'Сообщить об ошибке'}" Command="{Binding ReportBugCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.AutomationId="ReportBug" />
                        <TextBlock Text="{Binding FeedbackError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Оформление'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                        <TextBlock Text="{l:Tr 'Тема'}" FontSize="15" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{l:Tr 'Как в Windows'}" GroupName="Theme" IsChecked="{Binding IsThemeSystem, Mode=TwoWay}" Margin="0,0,28,0" AutomationProperties.AutomationId="ThemeSystem" />
                            <RadioButton Content="{l:Tr 'Светлая'}" GroupName="Theme" IsChecked="{Binding IsThemeLight, Mode=TwoWay}" Margin="0,0,28,0" AutomationProperties.AutomationId="ThemeLight" />
                            <RadioButton Content="{l:Tr 'Тёмная'}" GroupName="Theme" IsChecked="{Binding IsThemeDark, Mode=TwoWay}" AutomationProperties.AutomationId="ThemeDark" />
                        </StackPanel>
                        <TextBlock Text="{l:Tr 'Применяется сразу. «Как в Windows» следует режиму приложений в параметрах Windows.'}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Группы на рабочем столе'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr 'Раскрывать свёрнутый Fence при наведении'}" FontSize="15" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Tr 'Раскрытие и сворачивание без дополнительной задержки. После ухода курсора группа вернётся в своё свёрнутое состояние.'}" Style="{StaticResource Hint}" Margin="0,6,24,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoExpandOnHover, Mode=TwoWay}" AutomationProperties.AutomationId="HoverExpandToggle" AutomationProperties.Name="{l:Tr 'Раскрывать свёрнутый Fence при наведении'}" VerticalAlignment="Top" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr 'Всегда скрывать значки свёрнутых групп'}" FontSize="15" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Tr 'Включено: значки скрываются сразу после сворачивания. Выключено: пока курсор остаётся на заголовке, группу можно быстро раскрыть повторно.'}" Style="{StaticResource Hint}" Margin="0,6,24,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding ConcealCollapsedItems, Mode=TwoWay}" AutomationProperties.AutomationId="ConcealCollapsedToggle" AutomationProperties.Name="{l:Tr 'Всегда скрывать значки свёрнутых групп'}" VerticalAlignment="Top" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,18" />
                        <TextBlock Text="{l:Tr 'Плавное раскрытие и сворачивание'}" FontSize="15" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr 'Раскрытие · секунды'}" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding ExpandAnimationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}, ValidatesOnExceptions=True}" Margin="0,6,0,0" AutomationProperties.AutomationId="ExpandAnimationSeconds" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Tr 'Сворачивание · секунды'}" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding CollapseAnimationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}, ValidatesOnExceptions=True}" Margin="0,6,0,0" AutomationProperties.AutomationId="CollapseAnimationSeconds" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Tr 'От 0 до 3 секунд. 0 — мгновенно. Изменение сохраняется после выхода из поля и применяется к кнопке в заголовке и hover-раскрытию.'}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Окно и трей'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="{l:Tr 'Порядок остаётся, даже когда окно закрыто.'}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{l:Tr 'Крестик скрывает окно в системный трей. Группы продолжают работать на рабочем столе. Один клик по значку возвращает это окно.'}" Style="{StaticResource Hint}" />
                        <TextBlock Text="{l:Tr 'Чтобы полностью завершить приложение, выберите «Выход» в меню значка в трее.'}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
