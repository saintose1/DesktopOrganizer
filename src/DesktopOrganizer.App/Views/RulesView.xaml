<UserControl xmlns:l="clr-namespace:DesktopOrganizer.App.Views" x:Class="DesktopOrganizer.App.Views.RulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Tr 'Правила'}" Style="{StaticResource PageTitle}" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="{l:Tr 'Правила сами раскладывают новые файлы рабочего стола по группам.'}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Card}" Padding="20,6,20,10" Margin="0,0,0,16">
                    <Expander Header="{l:Tr 'Как это работает'}" IsExpanded="True" Margin="0" AutomationProperties.AutomationId="RulesHelp">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="{l:Tr 'Правило — это маска имени файла и группа. Когда на рабочем столе появляется новый файл (скачали, сохранили, создали ярлык), программа сама кладёт его в группу, чья маска ему подходит.'}" />
                            </TextBlock>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="1" Style="{StaticResource SectionTitle}" FontSize="16" Foreground="{DynamicResource Accent}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6" Text="{l:Tr 'Впишите маску внизу: по ней узнаётся тип файла. Звёздочка * заменяет любые символы, поэтому *.pdf — это все файлы PDF.'}" />
                                <TextBlock Grid.Row="1" Text="2" Style="{StaticResource SectionTitle}" FontSize="16" Foreground="{DynamicResource Accent}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6" Text="{l:Tr 'Выберите группу и нажмите «Добавить правило». Справа сразу видно, какие файлы с рабочего стола подошли бы.'}" />
                                <TextBlock Grid.Row="2" Text="3" Style="{StaticResource SectionTitle}" FontSize="16" Foreground="{DynamicResource Accent}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{l:Tr 'Дальше всё работает само. Уже разложенные значки правила не двигают; если подходят несколько групп, файл попадёт в первую из списка.'}" />
                            </Grid>
                            <TextBlock Text="{l:Tr 'Примеры масок'}" Style="{StaticResource Caption}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style x:Key="Mask" TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                    </Style>
                                    <Style x:Key="Meaning" TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Style="{StaticResource Mask}" Text="*.exe" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Meaning}" Text="{l:Tr 'программы и установщики'}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Mask}" Text="*.lnk" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Meaning}" Text="{l:Tr 'ярлыки, в том числе игр и приложений'}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Mask}" Text="*.pdf; *.docx; *.txt" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Meaning}" Text="{l:Tr 'документы; несколько масок пишутся через точку с запятой'}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource Mask}" Text="*.png; *.jpg" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Meaning}" Text="{l:Tr 'картинки и скриншоты'}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource Mask}" Text="Steam*" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Meaning}" Text="{l:Tr 'всё, что начинается со слова Steam'}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource Mask}" Text="{l:Tr '*отчёт*'}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Meaning}" Text="{l:Tr 'всё, где в названии есть «отчёт»'}" />
                                <TextBlock Grid.Row="6" Style="{StaticResource Mask}" Text="pdf" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Meaning}" Text="{l:Tr 'короткая запись: программа сама превратит её в *.pdf. Большие и маленькие буквы не различаются.'}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Grid Margin="20,14,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Tr 'Маска'}" Style="{StaticResource SectionTitle}" FontSize="17" />
                            <TextBlock Grid.Column="1" Text="{l:Tr 'Группа'}" Style="{StaticResource SectionTitle}" FontSize="17" />
                            <TextBlock Grid.Column="2" Text="{l:Tr 'Действия'}" Style="{StaticResource SectionTitle}" FontSize="17" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Line}" />
                        <TextBlock Text="{l:Tr 'Правил пока нет. Добавьте первое ниже.'}" Foreground="{DynamicResource Muted}" Margin="20,18,20,18" Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Rules}" AutomationProperties.AutomationId="RuleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Mask}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FenceName}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Content="{l:Tr 'Удалить'}" HorizontalAlignment="Right" Padding="12,5" FontSize="13"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Новое правило'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                            <TextBlock Text="{l:Tr 'Маска'}" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding NewRuleMask, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NewRuleMask" ToolTip="{l:Tr 'Например: *.pdf; Отчёт*; *.lnk'}" Margin="0,4,0,8" />
                            <TextBlock Text="{l:Tr 'Готовые маски — нажмите, чтобы подставить:'}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,12">
                                <WrapPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Padding" Value="10,4" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="Command" Value="{Binding UseMaskCommand}" />
                                    </Style>
                                </WrapPanel.Resources>
                                <Button Content="{l:Tr 'Программы'}" CommandParameter="*.exe; *.msi" ToolTip="*.exe; *.msi" AutomationProperties.AutomationId="MaskPrograms" />
                                <Button Content="{l:Tr 'Ярлыки'}" CommandParameter="*.lnk; *.url" ToolTip="*.lnk; *.url" />
                                <Button Content="{l:Tr 'Документы'}" CommandParameter="*.pdf; *.doc; *.docx; *.txt; *.rtf; *.odt" ToolTip="*.pdf; *.doc; *.docx; *.txt; *.rtf; *.odt" />
                                <Button Content="{l:Tr 'Таблицы'}" CommandParameter="*.xls; *.xlsx; *.csv" ToolTip="*.xls; *.xlsx; *.csv" />
                                <Button Content="{l:Tr 'Картинки'}" CommandParameter="*.png; *.jpg; *.jpeg; *.gif; *.webp" ToolTip="*.png; *.jpg; *.jpeg; *.gif; *.webp" />
                                <Button Content="{l:Tr 'Видео'}" CommandParameter="*.mp4; *.mkv; *.mov; *.avi" ToolTip="*.mp4; *.mkv; *.mov; *.avi" />
                                <Button Content="{l:Tr 'Музыка'}" CommandParameter="*.mp3; *.wav; *.flac" ToolTip="*.mp3; *.wav; *.flac" />
                                <Button Content="{l:Tr 'Архивы'}" CommandParameter="*.zip; *.rar; *.7z" ToolTip="*.zip; *.rar; *.7z" />
                            </WrapPanel>
                            <TextBlock Text="{l:Tr 'Группа'}" Style="{StaticResource Caption}" />
                            <ComboBox ItemsSource="{Binding Fences}" SelectedValuePath="Id" SelectedValue="{Binding NewRuleFenceId, Mode=TwoWay}" AutomationProperties.AutomationId="NewRuleGroup">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{l:Tr 'Добавить правило'}" Command="{Binding AddRuleCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AddRule" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Предпросмотр'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                            <TextBlock Text="{Binding RulePreviewSummary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.AutomationId="RulePreviewSummary" />
                            <ItemsControl ItemsSource="{Binding RulePreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="15" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,10,0,14">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
