<Window x:Class="DesktopOrganizer.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DesktopOrganizer.App.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="{Binding Title}" Icon="/DesktopOrganizer.App;component/Assets/Branding/application.ico" Width="1160" Height="850" MinWidth="900" MinHeight="600" Background="{StaticResource Base}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="−" Padding="16,6" Click="MinimizeWindow" AutomationProperties.Name="Свернуть окно" />
                        <Button Content="□" Padding="16,6" Click="ToggleMaximizeWindow" AutomationProperties.Name="Развернуть окно" />
                        <Button Content="×" Padding="16,6" Click="CloseWindow" AutomationProperties.Name="Скрыть в трей" />
                    </StackPanel>
                    <TextBlock Text="＋  DesktopOrganizer" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Accent}" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="#0D0E13">
                    <Grid Margin="20,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Image Source="/DesktopOrganizer.App;component/Assets/Branding/dog-original.png" Width="64" Height="64" HorizontalAlignment="Left" />
                            <TextBlock Text="Desktop&#xA;Organizer." FontSize="23" FontWeight="SemiBold" Margin="0,14,0,12" />
                            <TextBlock Text="PERSONAL DESKTOP" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <Button Content="▦   Fences" Command="{Binding OpenFencesCommand}" AutomationProperties.AutomationId="FencesPage">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Navigation}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFencesPage}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter Property="Background" Value="#21192F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="⚙   Настройки" Command="{Binding OpenSettingsCommand}" AutomationProperties.AutomationId="SettingsPage">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Navigation}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter Property="Background" Value="#21192F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="3">
                            <Image Source="/DesktopOrganizer.App;component/Assets/Branding/dog-original.png" Width="166" Height="166" Margin="0,0,0,16" />
                            <TextBlock Text="Место для важного.&#xA;Порядок для остального." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,24" />
                            <TextBlock Text="{Binding ConnectionLabel}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Accent}" AutomationProperties.AutomationId="DesktopStatus" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="30">
                    <views:FencesView Visibility="{Binding IsFencesPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:SettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>