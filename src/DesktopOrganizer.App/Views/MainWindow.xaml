<Window xmlns:l="clr-namespace:DesktopOrganizer.App.Views" x:Class="DesktopOrganizer.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DesktopOrganizer.App.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="{Binding Title}" Icon="/DesktopOrganizer.App;component/Assets/Branding/application.ico" Width="1180" Height="800" MinWidth="960" MinHeight="620" Background="{DynamicResource Base}" Foreground="{DynamicResource Text}" WindowStartupLocation="CenterScreen" WindowStyle="None" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Navigation}" />
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavFern" TargetType="Image">
            <Setter Property="Source" Value="/DesktopOrganizer.App;component/Assets/Forest/moss-frond.png" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,-6,0" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="views:Motion.TargetOpacity" Value="0.85" />
            <Setter Property="views:Motion.OffsetX" Value="12" />
            <Setter Property="views:Motion.OffsetY" Value="0" />
            <Setter Property="views:Motion.Duration" Value="320" />
            <Setter Property="views:Motion.Enter" Value="True" />
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" views:Motion.Enter="True" views:Motion.OffsetY="0" views:Motion.Duration="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Titlebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="MinimizeWindow" AutomationProperties.Name="{l:Tr 'Свернуть окно'}" />
                        <Button Style="{StaticResource WindowButton}" Content="&#xE922;" Click="ToggleMaximizeWindow" AutomationProperties.Name="{l:Tr 'Развернуть окно'}" />
                        <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" Click="CloseWindow" AutomationProperties.Name="{l:Tr 'Скрыть в трей'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="/DesktopOrganizer.App;component/Assets/Forest/moss-frond.png" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Desktop Organizer" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                    <Grid Margin="0,18,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,0">
                            <Button Command="{Binding OpenOverviewCommand}" AutomationProperties.AutomationId="OverviewPage">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverviewPage}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter Property="Background" Value="{DynamicResource NavActive}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" /><TextBlock Style="{StaticResource NavLabel}" Text="{l:Tr 'Обзор'}" /></StackPanel>
                                    <Image Style="{StaticResource NavFern}" Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding OpenFencesCommand}" AutomationProperties.AutomationId="FencesPage">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFencesPage}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter Property="Background" Value="{DynamicResource NavActive}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xF0E2;" /><TextBlock Style="{StaticResource NavLabel}" Text="{l:Tr 'Группы'}" /></StackPanel>
                                    <Image Style="{StaticResource NavFern}" Visibility="{Binding IsFencesPage, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding OpenRulesCommand}" AutomationProperties.AutomationId="RulesPage">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRulesPage}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter Property="Background" Value="{DynamicResource NavActive}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" /><TextBlock Style="{StaticResource NavLabel}" Text="{l:Tr 'Правила'}" /></StackPanel>
                                    <Image Style="{StaticResource NavFern}" Visibility="{Binding IsRulesPage, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="20,0,16,12" AutomationProperties.AutomationId="DesktopStatus" />
                            <Border Height="1" Background="{DynamicResource Line}" Margin="16,0,16,12" />
                            <Button Command="{Binding OpenSettingsCommand}" AutomationProperties.AutomationId="SettingsPage">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter Property="Background" Value="{DynamicResource NavActive}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" /><TextBlock Style="{StaticResource NavLabel}" Text="{l:Tr 'Настройки'}" /></StackPanel>
                                    <Image Style="{StaticResource NavFern}" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="30,22,30,0">
                    <views:OverviewView views:Motion.Enter="True" Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:FencesView views:Motion.Enter="True" Visibility="{Binding IsFencesPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:RulesView views:Motion.Enter="True" Visibility="{Binding IsRulesPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:SettingsView views:Motion.Enter="True" DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
