<Window x:Class="DesktopOrganizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="750" Width="940"
        MinHeight="550" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Группы рабочего стола" FontSize="28" FontWeight="SemiBold" Foreground="#1F2937" />
            <TextBlock Text="Перетаскивайте группы за заголовок, меняйте размер за края. Настоящие значки рабочего стола можно переносить в область группы и обратно."
                       Margin="0,8,0,0" Foreground="#4B5563" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#FFF3CD" Padding="12" Margin="0,0,0,12"
                Visibility="{Binding HasLoadWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding LoadWarning}" TextWrapping="Wrap" />
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Content="Новая группа" Command="{Binding CreateCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="CreateFence" Margin="0,0,0,12" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Fences}" SelectedItem="{Binding SelectedFence}"
                         AutomationProperties.AutomationId="FenceList" AutomationProperties.Name="Группы"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="#4B5563">
                                    <Run Text="X: " /><Run Text="{Binding X, Mode=OneWay}" />
                                    <Run Text="  Y: " /><Run Text="{Binding Y, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Foreground="#4B5563">
                                    <Run Text="{Binding Width, Mode=OneWay}" /><Run Text=" × " />
                                    <Run Text="{Binding Height, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Свёрнута" Foreground="#4B5563" Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Foreground="#4B5563"><Run Text="Иконок: " /><Run Text="{Binding Icons.Length, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Параметры группы" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="На рабочем столе изменения сохраняются после отпускания мыши. Здесь можно точно задать параметры кнопкой «Применить». Высота — размер развёрнутой группы."
                                   Margin="0,8,0,16" TextWrapping="Wrap" Foreground="#4B5563" />
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="Название (1–100 символов)" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="FenceName" AutomationProperties.Name="Название" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="X" />
                                    <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FenceX" AutomationProperties.Name="X" />
                                    <TextBlock Text="Ширина (больше 0)" />
                                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FenceWidth" AutomationProperties.Name="Ширина" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y" />
                                    <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FenceY" AutomationProperties.Name="Y" />
                                    <TextBlock Text="Высота (больше 0)" />
                                    <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FenceHeight" AutomationProperties.Name="Высота" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Применить" Command="{Binding ApplyCommand}" AutomationProperties.AutomationId="ApplyFence" />
                                <Button Content="Удалить" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="DeleteFence"
                                        ToolTip="Удаляет выбранную группу и сразу сохраняет список" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Error}" Foreground="#B91C1C" Margin="0,16,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Padding="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="#4B5563" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DesktopStatus}" Margin="0,6,0,0" Foreground="#1F2937"
                           ToolTip="{Binding DesktopDiagnostics}" AutomationProperties.AutomationId="DesktopStatus" />
                <TextBlock Text="{Binding IconStatus}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,4,0,0" />
                <Button Content="Показать рабочий стол" Command="{Binding ShowDesktopCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="ShowDesktop" Margin="0,6,0,0" />
                <Expander Header="Desktop diagnostics" Margin="0,4,0,0">
                    <TextBlock Text="{Binding DesktopDiagnostics}" TextWrapping="Wrap" FontSize="11" />
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
