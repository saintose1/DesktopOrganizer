<UserControl xmlns:l="clr-namespace:DesktopOrganizer.App.Views" x:Class="DesktopOrganizer.App.Views.FenceAppearanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DesktopOrganizer.App.Views">
  <UserControl.Resources>
    <views:FontPreviewConverter x:Key="FontPreview" />
    <views:HexOpacityBrushConverter x:Key="HexOpacityBrush" />
    <views:HexBrushConverter x:Key="HexBrush" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,10,0">
      <TextBlock Text="{l:Tr 'Внешний вид группы'}" Style="{StaticResource SectionTitle}" FontSize="22" />
      <TextBlock Text="{Binding SelectedFence.Name, TargetNullValue={l:Tr 'Выберите группу'}, FallbackValue={l:Tr 'Выберите группу'}}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
      <StackPanel IsEnabled="{Binding CanEdit}">
        <StackPanel DataContext="{Binding AppearanceEditor}">
          <Expander Header="{l:Tr 'Заголовок'}" IsExpanded="True">
            <StackPanel>
              <TextBlock Text="{l:Tr 'Название'}" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FenceName" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Tr 'Шрифт'}" Style="{StaticResource FieldLabel}" />
                  <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" AutomationProperties.AutomationId="TitleFont">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding Converter={StaticResource FontPreview}}" FontSize="14" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Tr 'Размер'}" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TitleSize" ToolTip="{l:Tr 'От 8 до 28; высота заголовка остаётся прежней'}" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal">
                <CheckBox Style="{StaticResource ChipCheck}" Content="{l:Tr 'Жирный'}" IsChecked="{Binding Bold}" AutomationProperties.AutomationId="TitleBold" />
                <CheckBox Style="{StaticResource ChipCheck}" Content="{l:Tr 'Курсив'}" IsChecked="{Binding Italic}" AutomationProperties.AutomationId="TitleItalic" />
              </StackPanel>
              <TextBlock Text="{l:Tr 'Выравнивание'}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment}" AutomationProperties.AutomationId="TitleAlignment">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{l:Tr 'Слева'}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="Center">
                              <Setter Property="Text" Value="{l:Tr 'По центру'}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Right">
                              <Setter Property="Text" Value="{l:Tr 'Справа'}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{l:Tr 'Цвет текста'}" Style="{StaticResource FieldLabel}" />
              <views:ColorPickerField Color="{Binding TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TitleColor" />
            </StackPanel>
          </Expander>
          <Expander Header="{l:Tr 'Панель заголовка'}">
            <StackPanel>
              <TextBlock Text="{l:Tr 'Цвет'}" Style="{StaticResource FieldLabel}" />
              <views:ColorPickerField Color="{Binding HeaderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="HeaderColor" />
              <TextBlock Style="{StaticResource FieldLabel}">
                <Run Text="{l:Tr 'Непрозрачность: '}" />
                <Run Text="{Binding HeaderOpacity, Mode=OneWay, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Value="{Binding HeaderOpacity, Mode=TwoWay}" AutomationProperties.AutomationId="HeaderOpacity" />
            </StackPanel>
          </Expander>
          <Expander Header="{l:Tr 'Основной фон'}">
            <StackPanel>
              <TextBlock Text="{l:Tr 'Цвет'}" Style="{StaticResource FieldLabel}" />
              <views:ColorPickerField Color="{Binding BodyColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BodyColor" />
              <TextBlock Style="{StaticResource FieldLabel}">
                <Run Text="{l:Tr 'Непрозрачность: '}" />
                <Run Text="{Binding BodyOpacity, Mode=OneWay, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Value="{Binding BodyOpacity, Mode=TwoWay}" AutomationProperties.AutomationId="BodyOpacity" />
            </StackPanel>
          </Expander>
          <Expander Header="{l:Tr 'Рамка'}">
            <StackPanel>
              <TextBlock Text="{l:Tr 'Цвет'}" Style="{StaticResource FieldLabel}" />
              <views:ColorPickerField Color="{Binding BorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BorderColor" />
              <TextBlock Style="{StaticResource FieldLabel}">
                <Run Text="{l:Tr 'Непрозрачность: '}" />
                <Run Text="{Binding BorderOpacity, Mode=OneWay, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Value="{Binding BorderOpacity, Mode=TwoWay}" AutomationProperties.AutomationId="BorderOpacity" />
            </StackPanel>
          </Expander>
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,8" />
          <TextBlock Text="{l:Tr 'Предпросмотр'}" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,10,0,8" />
          <Border x:Name="Preview" HorizontalAlignment="Left" Width="300" BorderThickness="1" AutomationProperties.AutomationId="AppearancePreview">
            <Border.BorderBrush>
              <MultiBinding Converter="{StaticResource HexOpacityBrush}">
                <Binding Path="BorderColor" />
                <Binding Path="BorderOpacity" />
              </MultiBinding>
            </Border.BorderBrush>
            <Border.Background>
              <MultiBinding Converter="{StaticResource HexOpacityBrush}">
                <Binding Path="BodyColor" />
                <Binding Path="BodyOpacity" />
              </MultiBinding>
            </Border.Background>
            <StackPanel>
              <Border Height="34">
                <Border.Background>
                  <MultiBinding Converter="{StaticResource HexOpacityBrush}">
                    <Binding Path="HeaderColor" />
                    <Binding Path="HeaderOpacity" />
                  </MultiBinding>
                </Border.Background>
                <TextBlock Text="{Binding Name}" FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize, FallbackValue=16}" Foreground="{Binding TextColor, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontWeight" Value="Normal" />
                      <Setter Property="FontStyle" Value="Normal" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Bold}" Value="True"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                        <DataTrigger Binding="{Binding Italic}" Value="True"><Setter Property="FontStyle" Value="Italic" /></DataTrigger>
                        <DataTrigger Binding="{Binding Alignment}" Value="Center"><Setter Property="HorizontalAlignment" Value="Center" /></DataTrigger>
                        <DataTrigger Binding="{Binding Alignment}" Value="Right"><Setter Property="HorizontalAlignment" Value="Right" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <UniformGrid Columns="3" Margin="6,8,6,8">
                <StackPanel><Image Source="/DesktopOrganizer.App;component/Assets/Forest/icon-globe.png" Width="40" Height="40" /><TextBlock Text="{l:Tr 'Браузер'}" FontSize="12" HorizontalAlignment="Center" Foreground="{Binding TextColor, Converter={StaticResource HexBrush}}" /></StackPanel>
                <StackPanel><Image Source="/DesktopOrganizer.App;component/Assets/Forest/icon-code.png" Width="40" Height="40" /><TextBlock Text="{l:Tr 'Редактор'}" FontSize="12" HorizontalAlignment="Center" Foreground="{Binding TextColor, Converter={StaticResource HexBrush}}" /></StackPanel>
                <StackPanel><Image Source="/DesktopOrganizer.App;component/Assets/Forest/icon-terminal.png" Width="40" Height="40" /><TextBlock Text="{l:Tr 'Терминал'}" FontSize="12" HorizontalAlignment="Center" Foreground="{Binding TextColor, Converter={StaticResource HexBrush}}" /></StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Button Content="{l:Tr 'Лесной стиль'}" Command="{Binding ForestPresetCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="{l:Tr 'Тёмно-зелёная рамка, засечки и мшистый акцент'}" AutomationProperties.AutomationId="ForestPreset" />
        </StackPanel>
        <TextBlock Text="{l:Tr 'Изменения видны на рабочем столе и сохраняются автоматически.'}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,14" />
        <Expander Header="{l:Tr 'Авто-сортировка'}" IsExpanded="False" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="{l:Tr 'Новые файлы на рабочем столе с подходящим именем сами попадут в эту группу. Через ; или пробел: *.png; *.lnk; Steam*'}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
            <TextBox Text="{Binding AutoSort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FenceAutoSort" Margin="0,8,0,10" />
            <Button Content="{l:Tr 'Сохранить правила'}" Command="{Binding SaveAutoSortCommand}" AutomationProperties.AutomationId="SaveAutoSort" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>
        <Button Content="{l:Tr 'Удалить группу'}" Command="{Binding DeleteCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="DeleteFence" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
