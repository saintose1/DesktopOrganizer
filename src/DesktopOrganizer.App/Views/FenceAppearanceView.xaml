<UserControl x:Class="DesktopOrganizer.App.Views.FenceAppearanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DesktopOrganizer.App.Views">
  <UserControl.Resources>
    <views:FontPreviewConverter x:Key="FontPreview" />
    <Style TargetType="ComboBox">
      <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#0B0C11" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,4,0,12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Foreground="{StaticResource Text}" x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0B0C11" CornerRadius="3">
                      <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="10,8,30,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                <Border Background="#16121E" BorderBrush="{StaticResource Accent}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240">
                  <ScrollViewer CanContentScroll="True">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Frame" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="#3A2C50" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="#2B203C" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Margin" Value="0,0,8,12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Frame" Background="#17131F" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="12,8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Frame" Property="Background" Value="#322344" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton Foreground="{StaticResource Text}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Accent}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="＋" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                  <Setter Property="Text" Value="−" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                      </DockPanel>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Content="{TemplateBinding Content}" Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,8,0,16" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="SmallChange" Value="1" />
      <Setter Property="LargeChange" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="22">
              <Border Height="3" Background="{StaticResource Line}" VerticalAlignment="Center" />
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource Accent}" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="ОФОРМЛЕНИЕ ГРУППЫ" Style="{StaticResource Caption}" />
      <TextBlock Text="{Binding SelectedFence.Name, TargetNullValue=Выберите группу, FallbackValue=Выберите группу}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
      <StackPanel IsEnabled="{Binding CanEdit}">
        <StackPanel DataContext="{Binding AppearanceEditor}">
          <Expander Header="Заголовок" IsExpanded="True">
            <StackPanel>
              <TextBlock Text="Название" Foreground="{StaticResource Muted}" FontSize="12" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FenceName" Margin="0,4,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="65" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Шрифт" Foreground="{StaticResource Muted}" FontSize="12" />
                  <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" AutomationProperties.AutomationId="TitleFont">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding Converter={StaticResource FontPreview}}" FontSize="14" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Размер" Foreground="{StaticResource Muted}" FontSize="12" />
                  <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TitleSize" Margin="0,4,0,12" ToolTip="От 8 до 28; высота заголовка остаётся прежней" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal">
                <CheckBox Content="Жирный" IsChecked="{Binding Bold}" AutomationProperties.AutomationId="TitleBold" />
                <CheckBox Content="Курсив" IsChecked="{Binding Italic}" AutomationProperties.AutomationId="TitleItalic" />
              </StackPanel>
              <TextBlock Text="Выравнивание" Foreground="{StaticResource Muted}" FontSize="12" />
              <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment}" AutomationProperties.AutomationId="TitleAlignment">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Слева" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="Center">
                              <Setter Property="Text" Value="По центру" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Right">
                              <Setter Property="Text" Value="Справа" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Цвет текста" Foreground="{StaticResource Muted}" FontSize="12" />
              <views:ColorPickerField Color="{Binding TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TitleColor" />
            </StackPanel>
          </Expander>
          <Expander Header="Панель заголовка">
            <StackPanel>
              <TextBlock Text="Цвет" Foreground="{StaticResource Muted}" FontSize="12" />
              <views:ColorPickerField Color="{Binding HeaderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="HeaderColor" />
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                <Run Text="Непрозрачность: " />
                <Run Text="{Binding HeaderOpacity, Mode=OneWay, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Value="{Binding HeaderOpacity, Mode=TwoWay}" AutomationProperties.AutomationId="HeaderOpacity" />
            </StackPanel>
          </Expander>
          <Expander Header="Основной фон">
            <StackPanel>
              <TextBlock Text="Цвет" Foreground="{StaticResource Muted}" FontSize="12" />
              <views:ColorPickerField Color="{Binding BodyColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BodyColor" />
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                <Run Text="Непрозрачность: " />
                <Run Text="{Binding BodyOpacity, Mode=OneWay, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Value="{Binding BodyOpacity, Mode=TwoWay}" AutomationProperties.AutomationId="BodyOpacity" />
            </StackPanel>
          </Expander>
          <Expander Header="Рамка">
            <StackPanel>
              <TextBlock Text="Цвет" Foreground="{StaticResource Muted}" FontSize="12" />
              <views:ColorPickerField Color="{Binding BorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BorderColor" />
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                <Run Text="Непрозрачность: " />
                <Run Text="{Binding BorderOpacity, Mode=OneWay, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Value="{Binding BorderOpacity, Mode=TwoWay}" AutomationProperties.AutomationId="BorderOpacity" />
            </StackPanel>
          </Expander>
          <TextBlock Text="{Binding Error}" Foreground="#FFA9B9" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,8" />
        </StackPanel>
        <TextBlock Text="Изменения видны на рабочем столе и сохраняются автоматически." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,16" />
        <Expander Header="Авто-сортировка" IsExpanded="False" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Новые файлы на рабочем столе с подходящим именем сами попадут в эту группу. Через ; или пробел: *.png; *.lnk; Steam*"
                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
            <TextBox Text="{Binding AutoSort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FenceAutoSort" Margin="0,4,0,8" />
            <Button Content="Сохранить правила" Command="{Binding SaveAutoSortCommand}" AutomationProperties.AutomationId="SaveAutoSort" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>
        <Button Content="Удалить группу" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="DeleteFence" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>