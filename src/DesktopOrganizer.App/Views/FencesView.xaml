<UserControl xmlns:l="clr-namespace:DesktopOrganizer.App.Views" x:Class="DesktopOrganizer.App.Views.FencesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DesktopOrganizer.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:Tr '01 / РАБОЧИЙ СТОЛ'}" Style="{StaticResource Caption}" />
            <TextBlock Text="{l:Tr 'Группы рабочего стола'}" FontSize="29" FontWeight="SemiBold" />
            <TextBlock Text="{l:Tr 'Всё важное — на своём месте.'}" Foreground="{StaticResource Muted}" Margin="0,8,0,26" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="{l:Tr '＋  Новая группа'}" Command="{Binding CreateCommand}" Style="{StaticResource Primary}" AutomationProperties.AutomationId="CreateFence" />
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}">
                <Run Text="{l:Tr 'Групп: '}" />
                <Run Text="{Binding Fences.Count, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" MinWidth="240" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBlock Text="{l:Tr 'Пока здесь пусто.&#xA;Создайте первую группу.'}" TextWrapping="Wrap" Margin="16,30">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Fences.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox ItemsSource="{Binding Fences}" SelectedItem="{Binding SelectedFence}" AutomationProperties.AutomationId="FenceList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="▱" Foreground="{StaticResource Accent}" FontSize="24" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" Margin="0,8,0,8" />
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                                    <Run Text="{l:Tr 'Значков: '}" />
                                    <Run Text="{Binding Icons.Length, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                                    <Run Text="{Binding Width, Mode=OneWay}" />
                                    <Run Text=" × " />
                                    <Run Text="{Binding Height, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource Accent}" FontSize="11" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{l:Tr 'РАЗВЁРНУТА'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                    <Setter Property="Text" Value="{l:Tr 'СВЁРНУТА'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <views:FenceAppearanceView />
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="{Binding LoadWarning}" Foreground="#E5CAA0" TextWrapping="Wrap" Visibility="{Binding HasLoadWarning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Error}" Foreground="#FFA9B9" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="{l:Tr 'К рабочему столу ↗'}" Command="{Binding ShowDesktopCommand}" AutomationProperties.AutomationId="ShowDesktop" Padding="10,6" />
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
