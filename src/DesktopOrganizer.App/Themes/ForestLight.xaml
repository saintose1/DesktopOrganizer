<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Forest: light palette (sage on warm paper). Same keys as ForestDark.xaml. -->
    <SolidColorBrush x:Key="Base" Color="#F1EFE4" />
    <SolidColorBrush x:Key="Sidebar" Color="#DDE3D1" />
    <SolidColorBrush x:Key="Titlebar" Color="#F0EFE3" />
    <SolidColorBrush x:Key="Panel" Color="#F7F6EC" />
    <SolidColorBrush x:Key="PanelHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#CBD2BD" />
    <SolidColorBrush x:Key="LineStrong" Color="#9AA68B" />
    <SolidColorBrush x:Key="Accent" Color="#4D6A39" />
    <SolidColorBrush x:Key="AccentFill" Color="#4D6A39" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#5C7C45" />
    <SolidColorBrush x:Key="OnAccent" Color="#F6F8EA" />
    <SolidColorBrush x:Key="NavActive" Color="#CCD8C1" />
    <SolidColorBrush x:Key="Text" Color="#1F2A1E" />
    <SolidColorBrush x:Key="Muted" Color="#5B6B58" />
    <SolidColorBrush x:Key="Field" Color="#FBFAF2" />
    <SolidColorBrush x:Key="Popup" Color="#F7F6EC" />
    <SolidColorBrush x:Key="PopupHover" Color="#E4EAD6" />
    <SolidColorBrush x:Key="PopupSelected" Color="#D5E0C6" />
    <SolidColorBrush x:Key="Danger" Color="#A33B3B" />
    <SolidColorBrush x:Key="Warning" Color="#8A6A1C" />
    <SolidColorBrush x:Key="CloseHover" Color="#C4655E" />
    <Color x:Key="BannerFade">#F1EFE4</Color>
    <Color x:Key="ShadeColor">#F1EFE4</Color>
</ResourceDictionary>
